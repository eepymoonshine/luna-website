[Unit]
Description=nginx web server
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/library/nginx:1.26
ContainerName=nginx
AutoUpdate=registry
User=33:33
IP=10.88.0.74
PublishPort=80:8080
Volume=/etc/nginx-quadlet/nginx.conf:/etc/nginx/nginx.conf:ro
Volume=/etc/nginx-quadlet/conf.d:/etc/nginx/conf.d:ro
Volume=/var/www/eepymoonshine-public:/var/www/eepymoonshine-public:ro
Volume=/var/www/perseus-homepage:/var/www/perseus-homepage:ro

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
